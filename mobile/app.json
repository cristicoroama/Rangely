{
  "expo": {
    "name": "Rangely",
    "slug": "rangely",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0c0d10",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0c0d10",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rangely.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rangely records your route while you ride, so it can work out your distance, speed and real range.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Rangely keeps recording with the screen off, so a ride is not cut short when you put the phone in your pocket.",
        "UIBackgroundModes": [
          "location",
          "location"
        ]
      }
    },
    "android": {
      "package": "app.rangely.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0c0d10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rangely records your route while you ride, so it can work out your distance, speed and real range.",
          "locationAlwaysAndWhenInUsePermission": "Rangely keeps recording with the screen off, so a ride is not cut short when you put the phone in your pocket.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4ffa280f-41b1-46f5-9e1a-ecd56a9b9d26"
      }
    },
    "owner": "coroama",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4ffa280f-41b1-46f5-9e1a-ecd56a9b9d26"
    }
  }
}
