{
  "expo": {
    "name": "Rangely",
    "slug": "rangely",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0d10",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0c0d10",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rangely.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rangely records your route while you ride, so it can work out your distance, speed and real range."
      }
    },
    "android": {
      "package": "app.rangely.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0c0d10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rangely records your route while you ride, so it can work out your distance, speed and real range."
        }
      ]
    ]
  }
}
